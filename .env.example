# Copy to .env and set values locally; .env is not loaded automatically.
# Export variables in your shell or use uvicorn --env-file with python-dotenv.
REELS_DATA_DIR=./data
# Required to bind the app beyond loopback. Use a long random value.
REELS_ACCESS_TOKEN=
# Public access requires HTTPS through a reverse proxy. No provider credentials
# are used by this version. Never put Facebook tokens in the browser.

# Optional persistent PostgreSQL/Supabase connection, server-side only.
# Leave empty to keep existing local SQLite data. Changing this does not migrate it.
DATABASE_URL=
# Streamlit local development only, never enable to replace cloud persistence:
# REELS_ALLOW_LOCAL_UI=1
