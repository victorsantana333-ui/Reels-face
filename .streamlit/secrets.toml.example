# Copy only in the hosting provider's Secrets editor or a local ignored
# .streamlit/secrets.toml. Never commit a real password or connection string.
REELS_ACCESS_TOKEN = "REPLACE_WITH_A_NEW_RANDOM_KEY_AT_LEAST_16_CHARACTERS"
DATABASE_URL = "postgresql://postgres.PROJECT_REF:ENCODED_NEW_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=system"
